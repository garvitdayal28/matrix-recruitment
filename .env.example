# Copy to .env.local (and set the same vars on Vercel). Never commit real values.

# Atlas > your cluster > Connect > Drivers. Replace <db_password> with the database user's password.
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Key to open /admin. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET=
