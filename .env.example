# Copy to .env.local (and set the same vars on Vercel). Never commit real values.

# Atlas > your cluster > Connect > Drivers. Replace <db_password> with the database user's password.
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Keys to open /admin. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Both keys see applications and visitor stats. ADMIN_MASTER_SECRET also sees developer LinkedIn clicks.
# Without a master key, ADMIN_SECRET sees everything.
ADMIN_SECRET=
ADMIN_MASTER_SECRET=

# WhatsApp group invite link, shown to applicants only after they submit.
WHATSAPP_GROUP_URL=
